# Copy to .env (repo root) and adjust.
ENV=dev                       # dev | prod  (prod requires JWT_SECRET)
JWT_SECRET=                   # long random string; auto-generated & persisted in dev if empty
DEMO_MODE=true                # one-click role logins on the login page – set false in production
DEMO_PASSWORD=                # password for seeded demo users (random & printed by the seed if empty)

# DATABASE_URL=sqlite:///backend/data/urban_planning.db

# LLM for the planning assistant, summaries, scenario narratives and recommendation briefs
LLM_PROVIDER=none             # openai | gemini | none (rule-based fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

NOMINATIM_ENABLED=true        # bounded OSM geocoding fallback for unknown place names
